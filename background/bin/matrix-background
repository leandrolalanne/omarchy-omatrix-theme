#!/usr/bin/env python3
"""Fondo de escritorio animado: la lluvia de Rezmason/matrix renderizada en vivo.

Por que asi y no de otra forma:

- Chromium no puede ser wallpaper. No habla layer-shell, y Hyprland 0.56 no
  tiene regla para mandar una ventana atras de todo. Una ventana flotante
  queda POR ENCIMA de las tiladas, que es exactamente lo contrario.
- QtWebEngine dentro de Quickshell se cae con core dump ("Argument list is
  empty, the program name is not passed to QCoreApplication"), asi que meter
  esto en el plugin de fondo de Omarchy tumbaria el shell entero: barra,
  notificaciones y lock incluidos.
- GTK3 + gtk-layer-shell + WebKit2GTK si puede: crea una superficie layer-shell
  propia en la capa BACKGROUND y embebe el render de upstream sin tocarlo.
  Medido: 60 fps con WebGL acelerado.

La superficie se dibuja encima del wallpaper de Omarchy (misma capa, creada
despues) pero con region de input vacia, asi el doble click del escritorio que
abre el selector de temas sigue funcionando igual.
"""

import argparse
import os
import signal
import sys
from pathlib import Path

import gi

# Gdk explicito: hay gtk4 instalado y si Gdk se importa sin version, gi carga
# la 4.0 y despues choca con Gtk 3.0.
gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
gi.require_version("WebKit2", "4.1")
import cairo  # noqa: E402
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell, WebKit2  # noqa: E402

THEME_DIR = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(THEME_DIR / "lib"))
import matrix_serve  # noqa: E402

VENDOR_DIR = THEME_DIR / "vendor" / "matrix"
PRESET_DIR = THEME_DIR / "presets"
USER_CONF = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "omarchy" / "matrix-background.conf"
DEFAULT_PRESET = "classic"


def presets():
    return sorted(p.stem for p in PRESET_DIR.glob("*.conf"))


def die(msg):
    sys.exit(f"matrix-background: {msg}")


def resolve_params(args):
    preset = args.version
    if not preset:
        preset = matrix_serve.read_conf(USER_CONF).get("version", DEFAULT_PRESET)

    preset_file = PRESET_DIR / f"{preset}.conf"
    if not preset_file.is_file():
        die(f"no existe el preset '{preset}'. Disponibles: {', '.join(presets())}")

    params = matrix_serve.read_conf(preset_file)
    matrix_serve.read_conf(USER_CONF, params)
    for kv in args.param or []:
        if "=" not in kv:
            die(f"--param espera clave=valor, no '{kv}'")
        key, _, value = kv.partition("=")
        params[key] = value
    if args.fps is not None:
        params["fps"] = str(args.fps)
    return preset, params


class Wallpaper:
    def __init__(self, url):
        self.url = url
        self.windows = {}
        self.display = Gdk.Display.get_default()
        if self.display is None:
            die("no hay display Wayland (¿corriendo fuera de la sesion?)")
        self.sync_monitors()
        self.display.connect("monitor-added", lambda d, m: self.add(m))
        self.display.connect("monitor-removed", lambda d, m: self.remove(m))

    def sync_monitors(self):
        for i in range(self.display.get_n_monitors()):
            self.add(self.display.get_monitor(i))

    def add(self, monitor):
        if monitor in self.windows:
            return
        win = Gtk.Window()
        GtkLayerShell.init_for_window(win)
        GtkLayerShell.set_namespace(win, "matrix-background")
        GtkLayerShell.set_layer(win, GtkLayerShell.Layer.BACKGROUND)
        GtkLayerShell.set_monitor(win, monitor)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                     GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(win, edge, True)
        # -1: no reservar espacio ni respetar el de otros. Un fondo ocupa todo.
        GtkLayerShell.set_exclusive_zone(win, -1)
        GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.NONE)

        view = WebKit2.WebView()
        settings = view.get_settings()
        settings.set_enable_webgl(True)
        settings.set_hardware_acceleration_policy(WebKit2.HardwareAccelerationPolicy.ALWAYS)
        settings.set_enable_developer_extras(False)
        settings.set_enable_page_cache(False)
        view.set_background_color(Gdk.RGBA(0, 0, 0, 1))
        view.load_uri(self.url)
        win.add(view)
        win.show_all()

        # Region de input vacia: los clicks atraviesan hasta el fondo de Omarchy,
        # asi el doble click que abre el selector de temas sigue andando.
        gdk_window = win.get_window()
        if gdk_window is not None:
            gdk_window.input_shape_combine_region(cairo.Region(), 0, 0)

        self.windows[monitor] = win

    def remove(self, monitor):
        win = self.windows.pop(monitor, None)
        if win is not None:
            win.destroy()

    def destroy_all(self):
        for win in list(self.windows.values()):
            win.destroy()
        self.windows.clear()


def main():
    ap = argparse.ArgumentParser(description="Fondo animado con la lluvia de Matrix.")
    ap.add_argument("--version", help=f"preset a usar (default: {DEFAULT_PRESET})")
    ap.add_argument("--param", action="append", help="clave=valor extra para Rezmason")
    ap.add_argument("--fps", type=int, help="limite de cuadros por segundo (0-60); bajarlo ahorra bateria")
    ap.add_argument("--list", action="store_true", help="lista los presets y sale")
    ap.add_argument("--print-url", action="store_true", help="muestra la URL resuelta y sale")
    args = ap.parse_args()

    if args.list:
        print("\n".join(presets()))
        return

    if not VENDOR_DIR.is_dir():
        die(f"falta la copia vendorizada en {VENDOR_DIR}")

    preset, params = resolve_params(args)
    query = matrix_serve.build_query(params)

    if args.print_url:
        print(f"preset: {preset}")
        print(f"url:    http://127.0.0.1:<puerto>/?{query}")
        return

    # Sin overlay: un fondo no debe salir ante input, al reves del screensaver.
    httpd, port = matrix_serve.serve(VENDOR_DIR, overlay=None)
    url = f"http://127.0.0.1:{port}/?{query}"

    wallpaper = Wallpaper(url)

    def shutdown(*_):
        wallpaper.destroy_all()
        httpd.shutdown()
        Gtk.main_quit()
        return GLib.SOURCE_REMOVE

    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, shutdown)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, shutdown)

    print(f"matrix-background: preset={preset} puerto={port} monitores={len(wallpaper.windows)}", flush=True)
    Gtk.main()


if __name__ == "__main__":
    main()
