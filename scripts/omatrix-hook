#!/bin/bash
# Everything omatrix has to (re)assert after a theme change, in one hook.
#
# TWO jobs, and the second one is not optional:
#
# 1. The font. `omarchy font set` is global and permanent -- it has no notion of
#    a theme -- so this is what makes it behave as though it belonged to omatrix.
#
# 2. The screensaver wordmark. Omarchy's screensaver is not a graphical program:
#    it runs `ttfx` over ~/.config/omarchy/branding/screensaver.txt, so the
#    screensaver IS that file. Swapped in on the way in, and the original put
#    back on the way out -- the first swap keeps a copy, so what is restored is
#    whatever was there before omatrix, not an assumption about it.
#
# Why Courier Prime, and why Bold: the lines on Neo's monitor (`Wake up,
# Neo...`) are set in a typewriter serif monospace, not the pixel or techno face
# the internet usually reaches for. tymurbogach's enter-the-matrix theme
# established this the honest way, by measuring against frames of the film: its
# cells agree with the typed lines to 0.3 px, and Regular reads thin and narrow
# next to the stills where the reference is blocky and compact. Courier Prime is
# a 2015 face, so it cannot literally be the film's -- the production would have
# had Courier or Courier New -- but it is the free, OFL-licensed equivalent that
# matches measurably.
#
# Omarchy passes the slug of the newly selected theme as $1.

set -euo pipefail

theme_font="Courier Prime"
theme_size=11

# Where leaving omatrix returns to. Always Omarchy's default, never "whatever
# was set on the way in": entering once with an odd size is enough to make that
# size stick across every other theme afterwards.
fallback_font="JetBrainsMono Nerd Font"
fallback_size=9

theme_name="${1:-}"
[[ -n $theme_name ]] || theme_name=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || true)

# fontconfig is the source of truth, the same one `omarchy font current` reads.
current_font=$(omarchy font current 2>/dev/null || true)

# `omarchy font set` changes the family in all four terminals and in
# fontconfig, but not the size, and it pins foot to :size=9. So the size is
# applied afterwards and foot's line is rewritten whole.
write_font() {
  local font=$1 size=$2
  omarchy font set "$font" >/dev/null 2>&1 || return 0

  local alacritty="$HOME/.config/alacritty/alacritty.toml"
  local ghostty="$HOME/.config/ghostty/config"
  local kitty="$HOME/.config/kitty/kitty.conf"
  local foot="$HOME/.config/foot/foot.ini"

  [[ -f $alacritty ]] && sed -i "s|^size = .*|size = $size|" "$alacritty"
  [[ -f $ghostty ]] && sed -i "s|^font-size = .*|font-size = $size|" "$ghostty"
  [[ -f $kitty ]] && sed -i "s|^font_size .*|font_size ${size}.0|" "$kitty"
  [[ -f $foot ]] && sed -i "s|^font=.*|font=$font:size=$size|" "$foot"

  # Those seds run after `omarchy font set` already signalled the terminals, so
  # they have to be told again about the size.
  omarchy restart terminal >/dev/null 2>&1 || true
}

# The screensaver's terminal inherits the user's whole ghostty config chain,
# translucency included -- verified by reading the config files it loads. A
# screensaver has to cover what is behind it, so this hands it a file that turns
# that back off, and that names the glyph font outright. It has to be a config
# file: ghostty ignores --background-opacity on the command line (measured: 0.2
# and 1.0 render identically), while a --config-file is honoured.
write_screensaver_conf() {
    local dir="$HOME/.local/state/omatrix"
    mkdir -p "$dir" || return 0

    # Shared by both screensavers.
    cat > "$dir/screensaver.conf" <<CONF
# Loaded only by the screensaver, through the ghostty shim. The theme's own
# omatrix.conf makes terminals translucent; a screensaver must not be.
background-opacity = 1
CONF

    # The rain only. It falls in the film's glyphs, which live in plane 16 and
    # are reached through this family alone. Declaring it HERE rather than
    # relying on a line in the user's ~/.config/ghostty/config is what makes the
    # screensaver independent: that line is a manual step matrix-rain suggests
    # for \`redpill\` and does not perform, so a machine can perfectly well have
    # the font and not the include.
    #
    # It must NOT reach the other screensaver: that one is the lines from Neo's
    # monitor, plain text, and this family maps no ASCII at all -- every letter
    # would come from whatever ghostty fell back to instead of the theme font.
    #
    # Written whether or not the font is installed, so adding matrix-rain later
    # needs no re-stage: scripts/system/ttfx checks at render time and asks for
    # plain katakana when nothing covers plane 16.
    cat > "$dir/screensaver-rain.conf" <<CONF
background-opacity = 1
font-family = "Matrix Code Terminal"
CONF
    return 0
}

# The second screensaver: the lines from Neo's monitor, with the login name in
# place of his. Written at theme-set rather than read at render time, because
# the shim that shows it runs inside the screensaver, where a failure is a black
# screen with nothing to read.
write_wakeup() {
    local dir="$HOME/.local/state/omatrix"
    local who="${USER:-$(id -un)}"
    mkdir -p "$dir" || return 0
    # Capitalised: it stands where a name stands in the film.
    who="${who^}"
    cat > "$dir/wakeup.txt" <<TXT
Wake up, $who...
The Omatrix has you...
Follow the White Rabbit...
Knock, knock, $who.
TXT
    return 0
}

# Omarchy's screensaver reads one file, so the wordmark is the screensaver.
# The .pre-omatrix copy is written once and never overwritten: switching themes
# twice must not end up saving our own logo as "the original".
swap_branding() {
    local ours="$HOME/.config/omarchy/themes/omatrix/branding/screensaver.txt"
    local live="$HOME/.config/omarchy/branding/screensaver.txt"
    local saved="$live.pre-omatrix"

    case "$1" in
      on)
        [[ -f $ours ]] || return 0
        [[ -f $saved || ! -f $live ]] || cp "$live" "$saved"
        cmp -s "$ours" "$live" 2>/dev/null || cp "$ours" "$live"
        ;;
      off)
        [[ -f $saved ]] || return 0
        cp "$saved" "$live" && rm -f "$saved"
        ;;
    esac
    return 0
}

case "${theme_name,,}" in
  omatrix)
    swap_branding on
    write_wakeup
    "$HOME/.config/omarchy/themes/omatrix/scripts/omatrix-whatsapp" omatrix 2>/dev/null || true
    write_screensaver_conf
    # The decoration this theme wants is declared in hyprland.lua, and the other
    # hooks overwrote it at runtime after that file was loaded. Reload rather
    # than re-assert: a reload reapplies whatever the active theme declares, so
    # the values live in exactly one place instead of being mirrored in bash
    # where they would quietly drift out of step.
    hyprctl reload >/dev/null 2>&1

    # Already on the font: do not rewrite configs or restart the shell for
    # nothing. Everything above still has to run on every theme-set.
    [[ $current_font == "$theme_font" ]] && exit 0
    write_font "$theme_font" "$theme_size"
    ;;
  *)
    # Only step in when leaving OUR font behind. If the user picked something
    # else by hand, a theme change has no business overriding it.
    swap_branding off
    "$HOME/.config/omarchy/themes/omatrix/scripts/omatrix-whatsapp" "$theme_name" 2>/dev/null || true
    [[ $current_font == "$theme_font" ]] || exit 0
    write_font "$fallback_font" "$fallback_size"
    ;;
esac
