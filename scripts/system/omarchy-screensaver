#!/bin/bash
# Force the matrix effect while omatrix is the active theme.
#
# Omarchy's screensaver hardcodes `--random-effect`, so one run in three lands
# on fireworks or bouncy balls, which is not what this theme is for. There is no
# option for it: the flag is written into /usr/bin/omarchy-screensaver.
#
# This shim does NOT reimplement that script -- it runs the real one, with a
# `ttfx` ahead of it in PATH that rewrites the one flag. Omarchy can rewrite its
# screensaver freely and this keeps working, as long as it still calls ttfx.
#
# It lives in /usr/local/bin because that directory comes before /usr/bin in the
# login PATH, which is what /usr/local is for. ~/.local/bin cannot be used: it
# comes AFTER /usr/bin, and putting it first would change how every command on
# the system resolves, to fix a screensaver.
#
# Any other theme falls straight through, untouched.

THEME=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)

if [[ ${THEME,,} == omatrix && -d /usr/local/libexec/omatrix ]]; then
  exec env PATH="/usr/local/libexec/omatrix:$PATH" /usr/bin/omarchy-screensaver "$@"
fi

exec /usr/bin/omarchy-screensaver "$@"
