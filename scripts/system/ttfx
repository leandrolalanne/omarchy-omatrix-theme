#!/bin/bash
# Pin Omarchy's screensaver to the matrix effect while omatrix is active.
#
# Omarchy's screensaver hardcodes `--random-effect`, so it lands on fireworks or
# bouncy balls as often as on the rain, and there is no option for it: the flag
# is written into the script.
#
# This intercepts `ttfx` rather than the screensaver, and the reason is the
# PATH. Omarchy puts its own bin at position 11, ahead of /usr/local/bin at 13,
# so a shim for omarchy-screensaver is never reached -- measured, after trying
# exactly that. ttfx has no such copy: it exists only in /usr/bin at 14, which
# /usr/local/bin does precede. So this is the one interception point that works.
#
# Inert unless BOTH conditions hold: omatrix is the current theme, and the
# caller asked for a random effect. Every other ttfx call on the system passes
# straight through, which matters because this shadows ttfx for everything.

for a in "$@"; do
  [[ $a == --random-effect ]] && random=1
done

theme=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)

if [[ ${random:-} != 1 || ${theme,,} != omatrix ]]; then
  exec /usr/bin/ttfx "$@"
fi

# Drop the flag and ask for the effect by name. ttfx takes the effect as a
# subcommand after the global options, so it is appended, not substituted.
# The greens are the ones the rest of the theme uses, measured off the rain:
#   176105 the dark end of the ramp, 89f76e its bright end, b0fa9e the pale top,
#   d9ffff the leading glyph of a falling drop.
# Which of the two screensavers the ghostty shim chose. It had to decide first:
# the point size is fixed when the terminal opens, long before this runs.
WAKEUP="$HOME/.local/state/omatrix/wakeup.txt"

if [[ ${OMATRIX_SCREENSAVER:-} == wake && -s $WAKEUP ]]; then
  # ttfx cannot do this one: it renders a whole file once, with no way to hold a
  # line, erase it and move to the next. So the typing happens here.
  #
  # This works because this shim IS a bash script called `ttfx`, which means its
  # comm is "ttfx" -- and omarchy-screensaver watches its effect with
  # `pgrep -t <tty> -x ttfx`, exiting the moment that returns nothing. Delegating
  # to python or any differently named helper would make that watch fail and the
  # screensaver would respawn in a tight loop.

  GREEN=$'\033[38;2;137;247;110m'   # the accent, the same green as the palette
  RESET=$'\033[0m'
  HOME_POS=$'\033[2J\033[3;4H'      # clear, then a small margin from the top left
  CURSOR_ON=$'\033[?25l'            # the block below is drawn, not the real cursor

  # NOT `LINES`: that is a bash special. Bash rewrites it with the terminal
  # height after every command, which overwrites element 0 of an array by that
  # name -- so the first phrase turned into the row count on the second loop
  # while the rest survived.
  mapfile -t PHRASES < "$WAKEUP"
  printf '%s%s' "$CURSOR_ON" "$GREEN"

  while true; do
    for line in "${PHRASES[@]}"; do
      printf '%s' "$HOME_POS"
      # Character by character, with a little jitter so it reads as typed by a
      # hand rather than played back by a machine.
      for ((i = 0; i < ${#line}; i++)); do
        printf '%s' "${line:i:1}"
        # printf, not "0.0$n": that form only holds while n has two digits and
        # silently becomes ten times faster at three.
        sleep "$(printf '0.%03d' $((95 + RANDOM % 75)))"
      done
      # Hold, with the block cursor blinking after the line the way it does on
      # Neo's monitor.
      for ((b = 0; b < 6; b++)); do
        printf '\u2588'; sleep 0.28
        printf '\b \b'; sleep 0.28
      done
    done
  done
fi

args=()
for a in "$@"; do
  [[ $a == --random-effect ]] || args+=("$a")
done

# The rain falls in the film's own glyphs, not ttfx's default halfwidth
# katakana. These are Matrix-Code.ttf's 56 codepoints shifted into plane 16 by
# MatrixCodeTerminal.ttf -- the same trick redpill uses, and for the same
# reason: plane 16 is empty, so the font can sit in a chain without ever
# supplying a character anyone types.
#
# It works here because the screensaver's terminal reads the user's ghostty
# config before its own -- verified by reading the font list it loads -- so
# ~/.config/ghostty/matrix-rain.conf is already in its chain.
#
# Regenerate with: tools/make-rain-symbols.py
RAIN_SYMBOLS="􀀢 􀀪 􀀫 􀀰 􀀱 􀀲 􀀳 􀀴 􀀵 􀀷 􀀸 􀀹 􀀺 􀀼 􀀾 􀁺 􀁼 􀂦 􀂩 􂕌 􂖪 􃂢 􃂦 􃂨 􃂪 􃂫 􃂭 􃂱 􃂳 􃂵 􃂷 􃂹 􃂻 􃂽 􃂿 􃃄 􃃆 􃃊 􃃋 􃃌 􃃍 􃃏 􃃒 􃃛 􃃞 􃃟 􃃠 􃃡 􃃢 􃃤 􃃨 􃃩 􃃪 􃃯 􃃼 􊞊"

exec /usr/bin/ttfx "${args[@]}" matrix \
  --rain-symbols $RAIN_SYMBOLS \
  --rain-color-gradient 185318 89f76e \
  --highlight-color d9ffff \
  --final-gradient-stops 176105 89f76e b0fa9e
