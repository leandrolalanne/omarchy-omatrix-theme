#!/bin/bash
# The banner on a new terminal: the first thing the film shows, as it happens.
#
# The Matrix opens on a screen, not on a face. The script's own stage direction
# has it read
#
#     Call trans opt: received. 2-19-96 13:24:18 REC:Log>
#     Trace program: running
#     Trace complete. Call origin: #312-555-0690
#
# which is already a terminal readout, so nothing has to be invented to fit --
# only the date and the origin are swapped for real ones. The trace that hunts
# Neo in the film lands on this machine instead, and the last line ends on `>`
# so the real prompt below reads as its continuation.
#
# It is typed out rather than printed, so it reads as a program running now.
# Evenly, with no jitter: this is a machine writing to a screen, not a person at
# a keyboard. The screensaver's lines are the other case and do have jitter.
#
# Then the digits of the address lock into place one at a time, which is what
# the scene does with the phone number while the trace closes in.
#
# No leading bar or gutter: the original has none, and Courier Prime -- the face
# this theme sets -- carries no box-drawing or block characters at all, so one
# would have come from a fallback font at a different weight.
#
# COST. This runs on every new terminal and the shell shows no prompt until it
# returns. Both speeds are knobs, and either at 0 turns that part off:
#
#     OMATRIX_TYPE_STEP     seconds per character   default 0.0015
#     OMATRIX_TRACE_STEP    seconds per lock frame  default 0.003125
#     OMATRIX_DOT_STEP      seconds per dot         default 0.0325
#
# Delays are a timed read on a fifo rather than `sleep`, which would fork ~130
# times in a shell's startup path. Measured over 100 delays: 1279 ms of forks
# against 1213 ms of builtin, on 1200 ms of intended wait.

set -u

GREEN=$'\033[38;2;137;247;110m'   # the theme accent
RESET=$'\033[0m'
HIDE=$'\033[?25l'
SHOW=$'\033[?25h'

TYPE=${OMATRIX_TYPE_STEP:-0.0015}
STEP=${OMATRIX_TRACE_STEP:-0.003125}
DOT=${OMATRIX_DOT_STEP:-0.0325}

when=$(date '+%-m-%-d-%y %H:%M:%S')

# The route lookup asks the kernel which source address it would use and
# contacts nobody, so it cannot hang a prompt.
origin=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{print $7; exit}')
[[ -n $origin ]] || origin=$(hostname -I 2>/dev/null | awk '{print $1}')
[[ -n $origin ]] || origin=127.0.0.1

L1="Call trans opt: received. $when REC:Log>"
L2="Trace program: running"
LEAD="Trace complete. Call origin: #"

# Redrawing the third line needs it to fit on one row: a wrapped line cannot be
# rewound with a carriage return. Below that width, print the lot and leave.
cols=${COLUMNS:-0}
(( cols > 0 )) || cols=$(tput cols 2>/dev/null || printf '80')
longest=${#L1}
(( ${#LEAD} + ${#origin} > longest )) && longest=$(( ${#LEAD} + ${#origin} ))

if (( cols <= longest + 1 )); then
  printf '\n%s%s\n%s\n%s%s%s\n\n' "$GREEN" "$L1" "$L2" "$LEAD" "$origin" "$RESET"
  exit 0
fi

# A fifo held open for reading and writing never reaches EOF, so a timed read on
# it is a pause: the wait happens in bash itself, with no process spawned.
pause() { :; }
fifo=$(mktemp -u) || fifo=
if [[ -n $fifo ]] && mkfifo "$fifo" 2>/dev/null; then
  exec 9<>"$fifo"; rm -f "$fifo"
  pause() { read -t "$1" -u 9 _ 2>/dev/null || true; }
else
  pause() { sleep "$1"; }
fi

type_out() {
  local s=$1 i
  for (( i = 0; i < ${#s}; i++ )); do
    printf '%s' "${s:i:1}"
    pause "$TYPE"
  done
}

printf '\n%s%s' "$HIDE" "$GREEN"
trap 'printf "%s%s" "$RESET" "$SHOW"' EXIT

type_out "$L1"; printf '\n'
type_out "$L2"
# The dots run twice: they appear one at a time, clear, and come again, which is
# what a program that is still working looks like. They are a beat, not a wait,
# so they get their own speed -- the rest of the banner is a machine printing and
# would look wrong at this rate.
for (( c = 0; c < 2; c++ )); do
  for (( d = 0; d < 3; d++ )); do
    printf '.'; pause "$DOT"
  done
  (( c == 0 )) && { printf '\b\b\b   \b\b\b'; pause "$DOT"; }
done
printf '\n'
type_out "$LEAD"

for (( k = 0; k <= ${#origin}; k++ )); do
  for (( s = 0; s < 2; s++ )); do
    noise=
    for (( j = k; j < ${#origin}; j++ )); do
      if [[ ${origin:j:1} == . ]]; then noise+=.; else noise+=$(( RANDOM % 10 )); fi
    done
    printf '\r%s%s%s' "$LEAD" "${origin:0:k}" "$noise"
    pause "$STEP"
  done
done

printf '\r%s%s\n\n' "$LEAD" "$origin"
