#!/usr/bin/env python3
"""Servidor local efimero para el screensaver Matrix.

Existe por dos razones:

1. index.html de Rezmason/matrix carga <script type="module">, y Chromium
   bloquea modulos ES sobre file:// por CORS. Hace falta un origen HTTP real.
2. Una pagina web no puede matar su propio proceso. overlay/exit.js pega a
   /__exit y este servidor baja el screensaver entero.

Sirve vendor/matrix/ tal cual e inyecta overlay/exit.js en el HTML al vuelo,
asi la copia vendorizada queda identica a upstream.

Escribe el puerto elegido en stdout (una linea) y despues se queda corriendo.
"""

import argparse
import http.server
import os
import socketserver
import sys
import threading
import urllib.parse
from pathlib import Path

INJECT_MARKER = b"</body>"
INJECT_TAG = b'<script src="/__overlay/exit.js"></script>\n\t</body>'

shutdown_requested = threading.Event()


class Handler(http.server.SimpleHTTPRequestHandler):
    overlay_dir: Path

    def log_message(self, fmt, *args):  # silencio: esto corre detras de un screensaver
        pass

    def do_GET(self):
        path = self.path.split("?", 1)[0]

        if path == "/__exit":
            self.send_response(204)
            self.send_header("Content-Length", "0")
            self.end_headers()
            query = urllib.parse.parse_qs(self.path.partition("?")[2])
            reason = query.get("reason", ["?"])[0]
            print(f"exit: {reason}", file=sys.stderr, flush=True)
            shutdown_requested.set()
            return

        if path == "/__ready":
            self.send_response(204)
            self.send_header("Content-Length", "0")
            self.end_headers()
            print("ready: overlay inyectado", file=sys.stderr, flush=True)
            return

        if path.startswith("/__overlay/"):
            return self._serve_overlay(path[len("/__overlay/"):])

        if path in ("/", "/index.html"):
            return self._serve_injected_index()

        return super().do_GET()

    def _serve_overlay(self, name):
        # Sin subdirectorios ni travesia: overlay/ es plano.
        candidate = (self.overlay_dir / name).resolve()
        if candidate.parent != self.overlay_dir.resolve() or not candidate.is_file():
            self.send_error(404)
            return
        body = candidate.read_bytes()
        self.send_response(200)
        self.send_header("Content-Type", "application/javascript; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _serve_injected_index(self):
        source = Path(self.directory) / "index.html"
        body = source.read_bytes()
        if INJECT_MARKER in body:
            body = body.replace(INJECT_MARKER, INJECT_TAG, 1)
        else:
            body += INJECT_TAG
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)


class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", required=True, help="directorio vendor/matrix")
    parser.add_argument("--overlay", required=True, help="directorio overlay/")
    parser.add_argument("--port", type=int, default=0, help="0 = puerto libre al azar")
    args = parser.parse_args()

    root = Path(args.root).resolve()
    overlay = Path(args.overlay).resolve()
    for label, directory in (("root", root), ("overlay", overlay)):
        if not directory.is_dir():
            sys.exit(f"matrix-screensaver-server: --{label} no es un directorio: {directory}")

    Handler.overlay_dir = overlay
    handler = lambda *a, **kw: Handler(*a, directory=str(root), **kw)

    with Server(("127.0.0.1", args.port), handler) as httpd:
        print(httpd.server_address[1], flush=True)
        threading.Thread(target=httpd.serve_forever, daemon=True).start()
        try:
            shutdown_requested.wait()
        except KeyboardInterrupt:
            pass
        httpd.shutdown()


if __name__ == "__main__":
    main()
